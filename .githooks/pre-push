#!/bin/sh
# The same address check as pre-commit, over everything outgoing. Worth having
# both: this one catches commits the other never saw — a cherry-pick, a rebase
# that carried an old author across, or work from a clone without the hooks.
#
# Enable (once per clone):  git config core.hooksPath .githooks

z40=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$z40" ] && continue # branch deletion, nothing to inspect

	# A remote tip we do not have locally is normal — someone merged a pull
	# request on the forge — and `rev-list remote..local` would just fail with
	# "Invalid revision range" and leak that to the user mid-push. Fall back to
	# "everything not already on a remote-tracking branch", which is the same
	# question asked in a way that always has an answer.
	if [ "$remote_sha" = "$z40" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		range=$(git rev-list "$local_sha" --not --remotes)
	else
		range=$(git rev-list "$remote_sha..$local_sha")
	fi
	[ -z "$range" ] && continue

	bad=$(git log --no-walk=unsorted --format='%H %an <%ae> %cn <%ce>' $range |
		grep -v '@users\.noreply\.github\.com>.*@users\.noreply\.github\.com>')

	if [ -n "$bad" ]; then
		echo "push refused: these commits carry a non-noreply email —" >&2
		echo "$bad" | sed 's/^/  /' >&2
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<'EOF'

Set the address, then rewrite the commits that have it wrong:

    git config user.email 'ID+username@users.noreply.github.com'
    git rebase -r --exec 'git commit --amend --no-edit --reset-author' <base>

Yours is shown on https://github.com/settings/emails.
EOF
fi

exit "$status"
