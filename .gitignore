# Build output
/bin/
/rendezvous
frontend/dist/

# build/ is NOT ignored wholesale: it also holds committed packaging inputs the
# release needs (appicon.svg, windows/icon.ico, windows/installer.nsi,
# versioninfo.json — see scripts/publish-release.sh). Only the generated
# subtrees go: wails output, and the patched libc module fork `make
# android-core` materializes.
/build/bin/
/build/libc-fork/

# Node
frontend/node_modules/

# Local multi-peer test data (make peers)
/.dev/

# Wails
/frontend/wailsjs/
dist-release/
resource_windows_amd64.syso

# Twemoji assets, copied from node_modules by `npm run prep-twemoji`
frontend/public/twemoji/

# Coding-agent state (sessions, worktrees, local settings) is per-machine and
# per-person. .claude/skills/ is the exception — those are checked-in project
# docs, so they stay tracked.
/.claude/*
!/.claude/skills/

# Bundled meme templates: third-party images with real rightsholders (see
# frontend/public/memes/README.md). Kept out of the repo so nothing here
# redistributes them; drop your own pack in this directory and the editor
# picks it up at runtime.
frontend/public/memes/
