{
  "name": "concord-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "npm run prep-twemoji && vite",
    "prep-twemoji": "rm -rf public/twemoji && mkdir -p public/twemoji && cp node_modules/@twemoji/svg/*.svg public/twemoji/",
    "build": "npm run prep-twemoji && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,mjs,svelte}\"",
    "test": "node src/lib/markdown.test.mjs && node src/lib/rail.test.mjs && node src/lib/keybind.test.mjs && node src/lib/notifs.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "svelte": "^5.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@twemoji/svg": "^15.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
