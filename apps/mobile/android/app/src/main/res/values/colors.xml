<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The bg-1 token from frontend/src/app.css. Used for the window background and the
         launch splash so the frame before the WebView paints is Concord's own
         colour rather than the platform white, which flashed on every cold start
         and on every sign-out (which reloads the page). -->
    <color name="concord_bg">#16181C</color>
    <!-- The launcher icon's background layer. It must cover the full adaptive
         canvas, so it is a colour rather than an inset drawable.

         Deliberately the app's own near-black, NOT the brand teal: a teal tile
         is what every generated-default icon in this class looks like, and on a
         home screen it read as "some green app". The mark carries the brand;
         the tile should get out of its way. -->
    <color name="concord_icon_bg">#16181C</color>
</resources>
