<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: what the OS uses for any window this app raises
         that isn't MainActivity — the task-manager card, the frame around a
         permission dialog, the gap between process start and the activity theme.
         It was Theme.AppCompat.Light in a dark-first app, which is where the
         white launch flash came from. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/concord_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Was @null, which is what left a transparent (black) window while the
             WebView loaded the bundle and the Go core booted. -->
        <item name="android:windowBackground">@color/concord_bg</item>
    </style>


    <!-- Android 12+ ignores android:background here and draws its own icon
         splash, so the ~20 generated splash.png variants were never shown. Give
         the platform splash the real parameters instead, and hand over to
         AppTheme.NoActionBar once MainActivity releases it (which it does when
         the web layer reports its first paint, not when the activity draws). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/concord_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_concord</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
