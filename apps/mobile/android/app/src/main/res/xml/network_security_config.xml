<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted to the loopback interface and nowhere else.

  Concord's Android app is a WebView over a Go core running in the same
  process. The core listens on 127.0.0.1 on an ephemeral port (mobile/mobile.go)
  and the WebView reaches it at http://127.0.0.1:<port>/rpc with a per-launch
  bearer token; the UI itself is served from the http://localhost origin
  Capacitor's asset loader synthesises. Both are plain HTTP, both stay inside
  the device, and TLS on either would mean shipping a certificate and a private
  key inside the APK — which is worse than no TLS, because it looks like TLS.

  Everything Concord sends off the device is already encrypted above the
  transport (Noise between peers, MLS inside that, HTTPS for the handful of
  named outbound calls PRIVACY.md lists). None of it needs cleartext, so the
  base configuration refuses it. The app previously carried a blanket
  usesCleartextTraffic="true", which permitted plaintext HTTP to any host on
  the internet to satisfy a listener that never leaves the loopback interface.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
