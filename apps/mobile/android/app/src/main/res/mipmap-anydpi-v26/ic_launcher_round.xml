<?xml version="1.0" encoding="utf-8"?>
<!-- The background is a flat colour, NOT an inset drawable: the background layer
     has to cover the whole 108dp or the launcher's mask cuts into transparency
     at the corners. The Capacitor template inset both layers by 16.7%. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/concord_icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
