<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- allowBackup MUST stay false: an OS backup restored onto another install
         would resurrect stale MLS ratchet state and fork every group the
         account is in. The 24-word mnemonic is the only supported migration. -->
    <!-- enableOnBackInvokedCallback: opt in to the ahead-of-time back API, so
         the system knows BEFORE a gesture completes whether the app will handle
         it. That is what draws the predictive preview — the home screen or the
         previous activity sliding in under the thumb — and it is why every
         launch until now logged "OnBackInvokedCallback is not enabled for the
         application". The app-side half is in ConcordCorePlugin.setBackDepth,
         which enables an OnBackPressedCallback only while the web navigation
         stack has something left to pop. -->
    <!-- networkSecurityConfig scopes cleartext HTTP to the loopback interface.
         Capacitor's CLI writes android:usesCleartextTraffic="true" into the
         generated cordova shim manifest whenever server.cleartext is set, and
         that attribute is app-wide: it permits plaintext HTTP to any host
         anywhere, to serve a Go core that only ever listens on 127.0.0.1.
         capacitor.config.json no longer sets it; @xml/network_security_config
         allows exactly 127.0.0.1 and localhost and refuses everything else.
         tools:replace keeps the scoping even if a plugin reintroduces the
         blanket attribute in a future sync. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- concord:// deep links — the device-linking QR encodes
                 concord://link?c=<code>, so scanning it with the system camera
                 opens the app with the code (handled via @capacitor/app's
                 appUrlOpen in frontend/src/lib/deeplink.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="concord" />
            </intent-filter>
            <!-- Share-sheet target, TEXT/LINKS ONLY for now (v1): handled in
                 MainActivity.handleShareIntent → "shareIn" plugin event → the
                 active conversation's composer. image/*, video/* and
                 ACTION_SEND_MULTIPLE are deliberately NOT declared yet —
                 stream bytes have no route into the composer's attachment
                 flow, and advertising a type we'd silently drop is worse than
                 not appearing in the sheet for it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Tray actions on message notifications: "Mark read" and the
             swipe-away/tap cleanup of the stacked MessagingStyle history. -->
        <receiver android:name=".MarkReadReceiver" android:exported="false" />

        <!-- Keeps the P2P node alive in the background so messages arrive. -->
        <service
            android:name=".ConcordForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Call-scoped: Android 14+ blocks background mic capture unless a
             microphone-type foreground service is running. Lives exactly as
             long as a call does. -->
        <service
            android:name=".ConcordCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi vs cellular, so peer discovery can run at a gentler cadence on a
         data plan (NetworkWatch -> Node.setMetered). Install-time and
         non-dangerous: no runtime prompt, and it reveals nothing about the
         network beyond whether the OS bills for it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- No CHANGE_WIFI_MULTICAST_STATE. It exists for mDNS, and mDNS cannot run
         on Android at all: SELinux denies the netlink socket bind zeroconf
         needs, so Host.startMDNS fails and the node discovers over DHT + relay
         instead. The permission was declared, its comment described a benefit
         nobody was getting, and the code that would have used it has been
         unreachable for as long as it has existed. -->
    <!-- Foreground service to keep the P2P node connected in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The call-scoped service above; without this type the mic goes silent
         the moment the app leaves the screen mid-call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice: WebView getUserMedia. Capacitor's BridgeWebChromeClient maps the
         webview's AUDIO/VIDEO_CAPTURE requests to these runtime permissions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- CallAudioPlugin's proximity wake lock: screen off against the cheek
         while the call is on the earpiece. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- USE_FINGERPRINT is injected by androidx.biometric, which arrives with
         the biometric app-lock plugin (Login.svelte). It was deprecated in API
         28 and replaced by USE_BIOMETRIC, which the library also declares and
         which is what every device running a supported Android version
         actually uses — but the library still declares the old one unscoped,
         so the merged manifest asked every install for a permission that has
         been meaningless since 2018. It is not removed outright because minSdk
         is 26: on API 26-27 the library really does fall back to
         FingerprintManager and really does need it. Capping it at 27 asks the
         two API levels that use it and nobody else. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27"
        tools:node="replace" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
