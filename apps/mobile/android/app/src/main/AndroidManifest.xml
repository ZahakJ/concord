<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup MUST stay false: an OS backup restored onto another install
         would resurrect stale MLS ratchet state and fork every group the
         account is in. The 24-word mnemonic is the only supported migration. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- concord:// deep links — the device-linking QR encodes
                 concord://link?c=<code>, so scanning it with the system camera
                 opens the app with the code (handled via @capacitor/app's
                 appUrlOpen in frontend/src/lib/deeplink.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="concord" />
            </intent-filter>
        </activity>

        <!-- Keeps the P2P node alive in the background so messages arrive. -->
        <service
            android:name=".ConcordForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Call-scoped: Android 14+ blocks background mic capture unless a
             microphone-type foreground service is running. Lives exactly as
             long as a call does. -->
        <service
            android:name=".ConcordCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android's Wi-Fi driver drops inbound multicast unless an app holds a
         multicast lock, so without this libp2p's mDNS never sees a peer on the
         same network — the phone can be sitting next to the desktop and still
         have to reach it the long way round, via the rendezvous. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Foreground service to keep the P2P node connected in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The call-scoped service above; without this type the mic goes silent
         the moment the app leaves the screen mid-call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice: WebView getUserMedia. Capacitor's BridgeWebChromeClient maps the
         webview's AUDIO/VIDEO_CAPTURE requests to these runtime permissions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
