<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup MUST stay false: an OS backup restored onto another install
         would resurrect stale MLS ratchet state and fork every group the
         account is in. The 24-word mnemonic is the only supported migration. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- concord:// deep links — the device-linking QR encodes
                 concord://link?c=<code>, so scanning it with the system camera
                 opens the app with the code (handled via @capacitor/app's
                 appUrlOpen in frontend/src/lib/deeplink.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="concord" />
            </intent-filter>
            <!-- Share-sheet target, TEXT/LINKS ONLY for now (v1): handled in
                 MainActivity.handleShareIntent → "shareIn" plugin event → the
                 active conversation's composer. image/*, video/* and
                 ACTION_SEND_MULTIPLE are deliberately NOT declared yet —
                 stream bytes have no route into the composer's attachment
                 flow, and advertising a type we'd silently drop is worse than
                 not appearing in the sheet for it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Tray actions on message notifications: "Mark read" and the
             swipe-away/tap cleanup of the stacked MessagingStyle history. -->
        <receiver android:name=".MarkReadReceiver" android:exported="false" />

        <!-- Keeps the P2P node alive in the background so messages arrive. -->
        <service
            android:name=".ConcordForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Call-scoped: Android 14+ blocks background mic capture unless a
             microphone-type foreground service is running. Lives exactly as
             long as a call does. -->
        <service
            android:name=".ConcordCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No CHANGE_WIFI_MULTICAST_STATE. It exists for mDNS, and mDNS cannot run
         on Android at all: SELinux denies the netlink socket bind zeroconf
         needs, so Host.startMDNS fails and the node discovers over DHT + relay
         instead. The permission was declared, its comment described a benefit
         nobody was getting, and the code that would have used it has been
         unreachable for as long as it has existed. -->
    <!-- Foreground service to keep the P2P node connected in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The call-scoped service above; without this type the mic goes silent
         the moment the app leaves the screen mid-call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice: WebView getUserMedia. Capacitor's BridgeWebChromeClient maps the
         webview's AUDIO/VIDEO_CAPTURE requests to these runtime permissions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- CallAudioPlugin's proximity wake lock: screen off against the cheek
         while the call is on the earpiece. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
